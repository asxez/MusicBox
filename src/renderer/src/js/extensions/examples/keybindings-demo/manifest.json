{
  "id": "keybindings-demo",
  "name": "Keybindings Demo Extension",
  "version": "1.0.0",
  "description": "演示如何使用快捷键 API 的示例扩展",
  "author": "MusicBox Team",
  "main": "keybindings-demo/extension.js",
  "activationEvents": [
    "onStartUp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "keybindingsDemo.showNotification",
        "title": "Keybindings Demo: Show Notification"
      },
      {
        "command": "keybindingsDemo.togglePlayPause",
        "title": "Keybindings Demo: Toggle Play/Pause"
      },
      {
        "command": "keybindingsDemo.nextTrack",
        "title": "Keybindings Demo: Next Track"
      }
    ]
  },
  "engines": {
    "musicbox": "^1.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "keybindings",
    "shortcuts",
    "demo",
    "example"
  ]
}
