{
  "experimentName": "paper-seek-robustness",
  "executionOrder": "round_robin",
  "warmupRepetitions": 1,
  "warmupDurationSec": 20,
  "strictFairness": true,
  "audioFiles": [
    {
      "id": "flac_source_96k",
      "path": "scripts/benchmarks/audio/open-goldberg-aria.flac"
    },
    {
      "id": "mp3_44k",
      "path": "scripts/benchmarks/audio/open-goldberg-aria.mp3"
    }
  ],
  "repetitions": 3,
  "durationSec": 180,
  "sampleIntervalMs": 1000,
  "ipcIterations": 0,
  "payloadBytes": [],
  "seekEverySec": 5,
  "seekPositions": [5, 30, 10, 45, 15, 60, 20, 75],
  "conditions": [
    {
      "id": "webaudio_seek",
      "backend": "webaudio"
    },
    {
      "id": "wasapi_shared_seek",
      "backend": "native",
      "shareMode": "shared"
    },
    {
      "id": "wasapi_exclusive_seek",
      "backend": "native",
      "shareMode": "exclusive"
    }
  ]
}
